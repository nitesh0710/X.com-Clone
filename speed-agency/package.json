{
  "name": "speed-agency",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild-checks.mjs",
    "preview": "npm run build && wrangler pages dev dist",
    "typecheck": "astro check && tsc -p functions/tsconfig.json --noEmit",
    "lint": "node scripts/lint-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "db:migrate:local": "wrangler d1 migrations apply speed-agency --local",
    "db:migrate:remote": "wrangler d1 migrations apply speed-agency --remote"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "astro": "7.4.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@fontsource/barlow-condensed": "5.2.6",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "typescript": "5.9.3",
    "wrangler": "^4.166.0"
  }
}
