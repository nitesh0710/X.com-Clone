---
import '@/styles/tokens.css';
import '@/styles/base.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/admin" class="logo"><span class="logo-mark" aria-hidden="true"></span>Admin</a>
        <nav aria-label="Admin">
          <ul class="nav-links">
            <li><a href="/admin">Leads</a></li>
            <li><a href="/admin/stats">Stats</a></li>
            <li><a href="/">Site</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap" style="padding-block:var(--s-6) var(--s-8)">
      <slot />
    </main>
  </body>
</html>
