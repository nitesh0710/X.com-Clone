---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import F from '@/components/F.astro';
import { articleLd } from '@/lib/seo';

interface Props {
  entry: CollectionEntry<'insights'>;
}
const { entry } = Astro.props;
const d = entry.data;
const path = `/insights/${entry.id}`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Insights', href: '/insights' },
  { name: d.title, href: path },
];
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title={d.seoTitle}
  description={d.description}
  crumbs={crumbs}
  ogType="article"
  jsonLd={[articleLd({ title: d.title, description: d.description, path, published: d.published, updated: d.updated })]}
>
  <article>
    <header class="page-hero wrap" data-hero>
      <span class="label">Insights</span>
      <h1 style="max-width:22ch">{d.title}</h1>
      <p class="muted mt-5">
        By <F k="FOUNDER_NAME" /> · <time datetime={d.published.toISOString()}>{fmt(d.published)}</time>
        {d.updated && <> · Updated <time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time></>}
      </p>
    </header>
    <div class="section alt" style="padding-top:var(--s-7)">
      <div class="wrap">
        <div class="prose" style="max-width:68ch">
          <slot />
        </div>
      </div>
    </div>
  </article>
  <CtaBand cta={`insight_${entry.id}_final_book`} />
</BaseLayout>
