---
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout title="Stats | Speed Agency admin">
  <h1 class="h2">Stats</h1>
  <div class="actions" role="group" aria-label="Date range" style="margin-top:var(--s-5)">
    <button class="btn btn-secondary" data-days="7" aria-pressed="false">Last 7 days</button>
    <button class="btn btn-secondary" data-days="30" aria-pressed="true">Last 30 days</button>
    <button class="btn btn-secondary" data-days="90" aria-pressed="false">Last 90 days</button>
  </div>
  <p class="muted mt-5">
    Visits, referrers and Core Web Vitals live in
    <a class="link" href="https://dash.cloudflare.com/?to=/:account/web-analytics" target="_blank" rel="noopener">Cloudflare Web Analytics</a>.
    Lead quality is marked by hand through each lead's status. There's no scoring model.
  </p>
  <p id="msg" class="notice mt-5" role="status" hidden></p>
  <div id="out" class="stats-grid mt-6"></div>
</AdminLayout>

<style>
  .stats-grid {
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 768px) {
    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  :global(.stat-big) {
    font-family: var(--font-head);
    font-size: 48px;
    font-weight: 700;
    line-height: 1;
  }
</style>

<script>
  type Stats = {
    days: number;
    cta: { label: string; n: number }[];
    formStarts: number;
    formSubmits: number;
    byNeed: { label: string; n: number }[];
    byCampaign: { label: string; n: number }[];
    bookings: number;
    funnel: { label: string; n: number }[];
    events: { label: string; n: number }[];
  };
  const out = document.getElementById('out')!;
  const msg = document.getElementById('msg')!;
  const el = (tag: string, text?: string, cls?: string) => {
    const e = document.createElement(tag);
    if (text != null) e.textContent = text;
    if (cls) e.className = cls;
    return e;
  };
  const panel = (title: string, body: HTMLElement) => {
    const p = el('section', undefined, 'panel stack');
    p.append(el('h2', title, 'label'), body);
    return p;
  };
  const table = (rows: { label: string; n: number }[], empty = 'Nothing yet.') => {
    if (!rows.length) return el('p', empty, 'muted');
    const t = el('table', undefined, 'table');
    const tb = el('tbody');
    for (const r of rows) {
      const tr = el('tr');
      tr.append(el('td', r.label || '(none)'), el('td', String(r.n)));
      tb.append(tr);
    }
    t.append(tb);
    return t;
  };
  async function load(days: number) {
    document.querySelectorAll<HTMLButtonElement>('[data-days]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.days === String(days))));
    const res = await fetch(`/api/admin/stats?days=${days}`);
    if (!res.ok) {
      msg.textContent = `Couldn't load stats (${res.status}).`;
      msg.hidden = false;
      return;
    }
    msg.hidden = true;
    const s = (await res.json()) as Stats;
    const rate = s.formStarts ? Math.round((s.formSubmits / s.formStarts) * 100) : 0;
    const completion = el('div');
    completion.append(el('p', `${s.formSubmits} / ${s.formStarts}`, 'stat-big'), el('p', `Form submits / form starts (${rate}% completion)`, 'muted'));
    const bookings = el('div');
    bookings.append(el('p', String(s.bookings), 'stat-big'), el('p', 'Calls booked through Cal.com', 'muted'));
    out.replaceChildren(
      panel('Form completion', completion),
      panel('Bookings', bookings),
      panel('CTA clicks by button', table(s.cta)),
      panel('Enquiries by need', table(s.byNeed)),
      panel('Enquiries by campaign (utm_campaign)', table(s.byCampaign)),
      panel('Status funnel (all leads in range)', table(s.funnel)),
      panel('All events', table(s.events)),
    );
  }
  document.querySelectorAll<HTMLButtonElement>('[data-days]').forEach((b) => b.addEventListener('click', () => load(Number(b.dataset.days))));
  load(30);
</script>
