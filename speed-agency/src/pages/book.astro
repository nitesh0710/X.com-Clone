---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { facts, hasFact } from '@/config/site';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Book a free call', href: '/book' },
];
const bookingUrl = hasFact('BOOKING_URL') ? facts.BOOKING_URL : null;
// Cal.com inline embed: append embed params to the public booking link.
const embedSrc = bookingUrl ? `${bookingUrl}${bookingUrl.includes('?') ? '&' : '?'}embed=true&theme=light&layout=month_view` : null;
---

<BaseLayout
  title="Book a Free 15-Minute Website Call | Speed Agency Studio"
  description="Pick a time for a free 15-minute call about your trade business. You'll get a fixed quote for your website within one business day. No pressure, no obligation."
  crumbs={crumbs}
  stickyBar={false}
  preconnect={bookingUrl ? ['https://cal.com', 'https://app.cal.com'] : []}
>
  <section class="page-hero wrap" data-hero>
    <span class="label">Book a call</span>
    <h1>Book a free 15-minute call.</h1>
    <p class="lede">
      Pick a time that suits you. We'll talk about your business, and you'll get a fixed quote within one business day. No
      pressure, no obligation.
    </p>
  </section>
  <section class="section alt" style="padding-top:var(--s-6)">
    <div class="wrap">
      {
        embedSrc ? (
          <div class="panel" style="padding:0">
            <iframe src={embedSrc} title="Choose a time for your free 15-minute call" loading="lazy" style="width:100%;height:760px;border:0;display:block" />
          </div>
        ) : (
          <div class="panel stack">
            <p class="label">Calendar</p>
            <p>The booking calendar appears here once it's connected: <mark class="ph">{'{{BOOKING_URL}}'}</mark></p>
          </div>
        )
      }
      {
        bookingUrl && (
          <p class="mt-4 small muted">
            Calendar not loading? <a class="link" href={bookingUrl} target="_blank" rel="noopener">Open it in a new tab</a>.
          </p>
        )
      }
      <p class="lede mt-6">
        <a href="/contact" class="text-link" data-cta="book_message">Prefer not to book? Send a message instead <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>
</BaseLayout>
