---
interface Props {
  label: string;
  title: string;
  lede?: string;
}
const { label, title, lede } = Astro.props;
---

<section class="page-hero wrap" data-hero>
  <span class="label">{label}</span>
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  {Astro.slots.has('lede') && <div class="lede"><slot name="lede" /></div>}
  <slot />
</section>
